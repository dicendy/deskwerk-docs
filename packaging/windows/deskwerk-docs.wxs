<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="Deskwerk Docs" Manufacturer="Deskwerk" Version="$(var.Version)" UpgradeCode="78337589-0956-416B-B1C6-FA48562A3C8C" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="Deskwerk Docs word processor" Manufacturer="Deskwerk" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Deskwerk Docs is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="DeskwerkDocsIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DeskwerkDocsIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/dicendy" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/dicendy/deskwerk-docs/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/dicendy/deskwerk-docs/issues" />

    <!-- Installer UI: the same wizard as Deskwerk Sheets (installer-ui.wxi, shared verbatim):
         welcome, ready to install (with "Create a desktop shortcut"), progress, finish (with
         "Launch Deskwerk Docs"). No licence page and no folder page: the licence texts are
         installed as plain files next to the app (AppNotices). -->
    <?define AppName="Deskwerk Docs" ?>
    <?define AppExeId="DeskwerkDocsExe" ?>
    <?define InstallerKey="Software\Deskwerk\Docs\Installer" ?>
    <!-- 0.15.6 and earlier kept only a marker here; it still counts as the saved choice. -->
    <?define LegacyInstallerKey="Software\DeskwerkDocs\Installer" ?>
    <?include $(sys.SOURCEFILEDIR)installer-ui.wxi?>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="Deskwerk">
        <Directory Id="INSTALLFOLDER" Name="Docs" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Deskwerk Docs" Level="1">
      <ComponentGroupRef Id="AppNotices" />
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="DeskwerkDocsFiles" />
      <ComponentGroupRef Id="DeskwerkDocsDesktop" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppNotices" Directory="INSTALLFOLDER">
      <Files Include="$(var.AppNoticesDir)\**" />
    </ComponentGroup>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="DeskwerkDocsFiles" Directory="INSTALLFOLDER">
      <Component Id="DeskwerkDocsApp" Guid="BFAE4B60-635B-4F12-840F-F7F114B2B5AA">
        <File Id="DeskwerkDocsExe" Source="$(var.BinDir)\deskwerk-docs.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Deskwerk Docs" Description="Deskwerk Docs word processor" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="DeskwerkDocsIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\deskwerk-docs.exe" Value="[#DeskwerkDocsExe]" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\DeskwerkDocs" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <!-- File associations (#295). Each document type gets a Deskwerk Docs ProgId (name, icon, open
           command) and is listed under the extension's OpenWithProgids, so Deskwerk Docs shows in
           Explorer's "Open with". The Word, RTF and ODT types are also Deskwerk Docs's Capabilities
           (RegisteredApplications), so it appears in Settings › Default apps, where the user
           makes it the default (File › Options › General opens that page). Nothing here sets an
           extension's default: the installer never takes over .docx from another app. Markdown and
           plain text are only "Open with" candidates. Removed again on uninstall.
           The Word, RTF and ODT ProgIds show the Deskwerk document icon (deskwerk-docs-document.ico,
           installed next to the exe); Explorer uses it for those files once Deskwerk Docs opens
           them by default. Markdown and plain text keep the app icon. -->
      <Component Id="DeskwerkDocsDocumentIcon">
        <File Id="DocumentIcon" Source="$(var.BinDir)\deskwerk-docs-document.ico" KeyPath="yes" />
      </Component>
      <Component Id="DeskwerkDocsFileTypes" Guid="B66C1151-D835-4630-BA22-A5826B53461D">
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="Deskwerk Docs" Value="Software\DeskwerkDocs\Capabilities" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKMU" Key="Software\DeskwerkDocs\Capabilities" Name="ApplicationName" Value="Deskwerk Docs" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\DeskwerkDocs\Capabilities" Name="ApplicationDescription" Value="Write and design documents; open and save Word files." Type="string" />
        <RegistryValue Root="HKMU" Key="Software\DeskwerkDocs\Capabilities" Name="ApplicationIcon" Value="&quot;[#DeskwerkDocsExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\deskwerk-docs.exe" Name="FriendlyAppName" Value="Deskwerk Docs" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\deskwerk-docs.exe\shell\open\command" Value="&quot;[#DeskwerkDocsExe]&quot; &quot;%1&quot;" Type="string" />

        <ProgId Id="DeskwerkDocs.Document" Description="Word Document" Icon="DocumentIcon" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\DeskwerkDocs.Document\shell\open\command" Value="&quot;[#DeskwerkDocsExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.docx\OpenWithProgids" Name="DeskwerkDocs.Document" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\deskwerk-docs.exe\SupportedTypes" Name=".docx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\DeskwerkDocs\Capabilities\FileAssociations" Name=".docx" Value="DeskwerkDocs.Document" Type="string" />

        <ProgId Id="DeskwerkDocs.DocumentMacroEnabled" Description="Word Macro-Enabled Document" Icon="DocumentIcon" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\DeskwerkDocs.DocumentMacroEnabled\shell\open\command" Value="&quot;[#DeskwerkDocsExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.docm\OpenWithProgids" Name="DeskwerkDocs.DocumentMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\deskwerk-docs.exe\SupportedTypes" Name=".docm" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\DeskwerkDocs\Capabilities\FileAssociations" Name=".docm" Value="DeskwerkDocs.DocumentMacroEnabled" Type="string" />

        <ProgId Id="DeskwerkDocs.Template" Description="Word Template" Icon="DocumentIcon" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\DeskwerkDocs.Template\shell\open\command" Value="&quot;[#DeskwerkDocsExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.dotx\OpenWithProgids" Name="DeskwerkDocs.Template" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\deskwerk-docs.exe\SupportedTypes" Name=".dotx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\DeskwerkDocs\Capabilities\FileAssociations" Name=".dotx" Value="DeskwerkDocs.Template" Type="string" />

        <ProgId Id="DeskwerkDocs.TemplateMacroEnabled" Description="Word Macro-Enabled Template" Icon="DocumentIcon" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\DeskwerkDocs.TemplateMacroEnabled\shell\open\command" Value="&quot;[#DeskwerkDocsExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.dotm\OpenWithProgids" Name="DeskwerkDocs.TemplateMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\deskwerk-docs.exe\SupportedTypes" Name=".dotm" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\DeskwerkDocs\Capabilities\FileAssociations" Name=".dotm" Value="DeskwerkDocs.TemplateMacroEnabled" Type="string" />

        <ProgId Id="DeskwerkDocs.LegacyDocument" Description="Legacy Word Document" Icon="DocumentIcon" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\DeskwerkDocs.LegacyDocument\shell\open\command" Value="&quot;[#DeskwerkDocsExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.doc\OpenWithProgids" Name="DeskwerkDocs.LegacyDocument" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\deskwerk-docs.exe\SupportedTypes" Name=".doc" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\DeskwerkDocs\Capabilities\FileAssociations" Name=".doc" Value="DeskwerkDocs.LegacyDocument" Type="string" />

        <ProgId Id="DeskwerkDocs.LegacyTemplate" Description="Legacy Word Template" Icon="DocumentIcon" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\DeskwerkDocs.LegacyTemplate\shell\open\command" Value="&quot;[#DeskwerkDocsExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.dot\OpenWithProgids" Name="DeskwerkDocs.LegacyTemplate" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\deskwerk-docs.exe\SupportedTypes" Name=".dot" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\DeskwerkDocs\Capabilities\FileAssociations" Name=".dot" Value="DeskwerkDocs.LegacyTemplate" Type="string" />

        <ProgId Id="DeskwerkDocs.RichText" Description="Rich Text Document" Icon="DocumentIcon" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\DeskwerkDocs.RichText\shell\open\command" Value="&quot;[#DeskwerkDocsExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.rtf\OpenWithProgids" Name="DeskwerkDocs.RichText" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\deskwerk-docs.exe\SupportedTypes" Name=".rtf" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\DeskwerkDocs\Capabilities\FileAssociations" Name=".rtf" Value="DeskwerkDocs.RichText" Type="string" />

        <ProgId Id="DeskwerkDocs.OpenDocumentText" Description="OpenDocument Text" Icon="DocumentIcon" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\DeskwerkDocs.OpenDocumentText\shell\open\command" Value="&quot;[#DeskwerkDocsExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.odt\OpenWithProgids" Name="DeskwerkDocs.OpenDocumentText" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\deskwerk-docs.exe\SupportedTypes" Name=".odt" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\DeskwerkDocs\Capabilities\FileAssociations" Name=".odt" Value="DeskwerkDocs.OpenDocumentText" Type="string" />

        <ProgId Id="DeskwerkDocs.Markdown" Description="Markdown Document" Icon="DeskwerkDocsExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\DeskwerkDocs.Markdown\shell\open\command" Value="&quot;[#DeskwerkDocsExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.md\OpenWithProgids" Name="DeskwerkDocs.Markdown" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\deskwerk-docs.exe\SupportedTypes" Name=".md" Value="" Type="string" />

        <ProgId Id="DeskwerkDocs.PlainText" Description="Text Document" Icon="DeskwerkDocsExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\DeskwerkDocs.PlainText\shell\open\command" Value="&quot;[#DeskwerkDocsExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.txt\OpenWithProgids" Name="DeskwerkDocs.PlainText" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\deskwerk-docs.exe\SupportedTypes" Name=".txt" Value="" Type="string" />
      </Component>

      <Component Id="DeskwerkDocsCli">
        <File Id="DeskwerkDocsCliExe" Source="$(var.BinDir)\deskwerk-docs-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!-- Desktop shortcut, chosen on the ready page (ticked on a new installation) or with
         DESKTOPSHORTCUT=0/1 on the msiexec command line; see installer-ui.wxi. It follows the
         install context (the common desktop for Everyone, the user's own for Only for me) and
         goes away on uninstall. -->
    <ComponentGroup Id="DeskwerkDocsDesktop">
      <!-- The choice itself (1 or 0), read back by the next upgrade in the same context. -->
      <Component Id="DesktopShortcutPreference" Directory="INSTALLFOLDER" Guid="AFA51737-D498-4006-95C5-3D7CDCE58075">
        <RegistryValue Root="HKMU" Key="Software\Deskwerk\Docs\Installer" Name="DesktopShortcut" Value="[DESKTOPSHORTCUT]" Type="string" KeyPath="yes" />
      </Component>
      <!-- New GUID: the key path moved from Software\DeskwerkDocs\Installer (0.15.6). HKMU follows
           the install context, so the marker (and the shortcut with it) is removed by whichever
           account uninstalls; MSI root -1 also satisfies ICE43. -->
      <Component Id="DeskwerkDocsDesktopShortcut" Directory="DesktopFolder" Guid="1A610325-E692-43DB-98C6-21DACF415754" Condition="DESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="DesktopShortcut" Name="Deskwerk Docs" Description="Deskwerk Docs word processor" Target="[#DeskwerkDocsExe]" WorkingDirectory="INSTALLFOLDER" Icon="DeskwerkDocsIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Deskwerk\Docs\Installer" Name="DesktopShortcutComponent" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
